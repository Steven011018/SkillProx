# Copy to `.env`; python-dotenv loads it automatically. Fill in exactly
# one of the provider blocks below. Never commit `.env`.

# ── OpenAI ───────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"   # only set this for a
                                                # custom OpenAI-compatible
                                                # endpoint.

# ── Azure OpenAI ─────────────────────────────────────────────────────
# AZURE_OPENAI_API_KEY=""
# AZURE_OPENAI_ENDPOINT="https://<your-resource>.openai.azure.com/openai/v1/"

# ── Self-hosted vLLM (e.g. Qwen) ─────────────────────────────────────
# Uses the same OpenAI-compatible path as Azure. The key can be any
# non-empty string unless your server enforces one.
# AZURE_OPENAI_API_KEY="EMPTY"
# AZURE_OPENAI_ENDPOINT="http://<host>:<port>/v1/"
# Comma-separated replicas; requests are round-robined with failover.
# SKILLGRAD_VLLM_ENDPOINTS="http://<host-a>:<port>/v1/,http://<host-b>:<port>/v1/"
# SKILLGRAD_ENDPOINT_RETRIES=1

# ── Gemini ───────────────────────────────────────────────────────────
# GEMINI_API_KEY=""

# ── Optional runtime knobs ───────────────────────────────────────────
# SKILLGRAD_TEMPERATURE=0.7          # Qwen defaults to 0.7
# SKILLGRAD_QWEN_THINKING=0          # set 1 to keep Qwen thinking enabled
# SKILLGRAD_EXEC_RETRIES=0           # re-run an executor that wrote no output
# SE_PIPELINE_REAL_SOFFICE=/path/to/soffice   # LibreOffice for formula recalculation
